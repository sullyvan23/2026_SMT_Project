
ball_events <- ball_events %>% mutate(play_key = paste0(game_string, play_per_game))
catch_prob_plays <- catch_prob_all_time_pred_2 %>% group_by(play_key, player_id) %>% slice(1)
plays_caught_or_not <- catch_prob_plays %>% group_by(play_key) %>% slice(1) %>% dplyr::select(play_key, caught)

baserunner_positions <- player_positions %>% filter(player_id %in% c(11:13))
baserunner_positions <- baserunner_positions %>% mutate(play_key = paste0(game_string, play_per_game))

fly_ball_events <- ball_events %>% filter(play_key %in% plays_caught_or_not$play_key)
fly_ball_events <- fly_ball_events %>% left_join(plays_caught_or_not, by = "play_key")
fly_ball_events <- fly_ball_events %>% left_join(baserunner_positions[,c(3:6,11)], by = c("play_key", "timestamp"), suffix = c("", "_br"))

fly_ball_events <- fly_ball_events %>% group_by(play_key) %>% filter(sum(is.na(player_id_br)) == 0)

fly_ball_events <- fly_ball_events %>% ungroup() %>% mutate(dist_1st = sqrt((field_x - 63.64)^2 + (field_y - 63.64)^2),
                                                            dist_2nd = sqrt(field_x^2 + (field_y - 127.28)^2),
                                                            dist_3rd = sqrt((field_x + 63.64)^2 + (field_y - 63.64)^2),
                                                            dist_home = sqrt(field_x^2 + field_y^2),
                                                            original_base = case_when(player_id_br == 11 ~ 1,
                                                                                      player_id_br == 12 ~ 2,
                                                                                      player_id_br == 13 ~ 3)) %>% 
                                                      relocate(original_base, .before = player_id_br)

fly_ball_events <- fly_ball_events %>% mutate(basepath = case_when(field_y < 0 | (field_y < 50 & field_x > 0)  ~  4, 
                                                                   field_y >= 60 & field_x > 0  ~  1 + (dist_1st / (dist_1st + dist_2nd)),
                                                                   field_y >= 63.64 & field_x <= 0  ~  2 + (dist_2nd / (dist_2nd + dist_3rd)),
                                                                   field_y < 63.64 & field_x <= 0  ~  3 + (dist_3rd / (dist_3rd + dist_home)) )) %>% 
                                       relocate(basepath, .before = player_id_br)


##########################################################################################################################################################################

potential_tag_up <- fly_ball_events %>% filter(caught == 1)

tag_caught <- potential_tag_up %>% filter(player_id %in% c(7:9) & ball_eventcode == 2) %>% group_by(play_key, player_id_br) %>% slice(1)
tag_caught <- tag_caught %>% mutate(key = paste0(play_key, "_", player_id_br))

tag_end <- potential_tag_up %>% group_by(play_key, player_id_br) %>% slice(n())
tag_end <- tag_end %>% mutate(key = paste0(play_key, "_", player_id_br))
tag_end <- tag_end %>% filter(key %in% tag_caught$key)

tag_check <- bind_rows(tag_caught, tag_end) %>% group_by(key) %>% arrange(key)
tag_check <- tag_check %>% mutate(og_base_catch_dist = first(basepath) - original_base,
                                  after_catch_dist = last(basepath) - first(basepath))
plot(tag_check$og_base_catch_dist, tag_check$after_catch_dist)

less_2_outs_caught <- tag_check %>% filter(!(og_base_catch_dist >= 0.3 & after_catch_dist >= -0.1))
plot(less_2_outs_caught$og_base_catch_dist, less_2_outs_caught$after_catch_dist)

tagged_up <- less_2_outs_caught %>% filter(after_catch_dist > 0.5)
stayed_base <- less_2_outs_caught %>% filter(after_catch_dist < 0.5)

##########################################################################################################################################################################

ball_lands_go <- fly_ball_events %>% filter(caught == 0)
ball_lands_go <- ball_lands_go %>% group_by(play_key, player_id_br) %>% distinct(play_key, game_string, play_per_game, player_id_br, original_base)

ball_lands_go <- ball_lands_go %>% left_join(baserunner_positions[,c(3:6,11)], by = c("play_key", "player_id_br" = "player_id"))
ball_lands_go <- ball_lands_go %>% slice(n())

plot(ball_lands_go$field_x, ball_lands_go$field_y)

ball_lands_go <- ball_lands_go %>% mutate(final_base = case_when(field_y > 100  ~  2,
                                                                 field_x < -45  ~  3,
                                                                 TRUE  ~  4),
                                          att_bases_advanced = final_base - original_base) %>% ungroup() %>% dplyr::select(-c(timestamp:field_y))
