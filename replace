pot_tag_data <- pot_tag_data %>% mutate(ground_next_towards_dist = -((OF_ball_x_dist * ground_next_x_dist) + (OF_ball_y_dist * ground_next_y_dist)) / 
                                                                  ground_next_dist)
pot_tag_data <- pot_tag_data %>% mutate(ground_next_angle = acos(-ground_next_towards_dist / ground_next_dist))
pot_tag_data <- pot_tag_data %>% mutate(unit_x = ground_next_x_dist / ground_next_dist,
                                        unit_y = ground_next_y_dist / ground_next_dist,
                                        ground_next_side_dist = ground_next_dist * sin(ground_next_angle),
                                        pos_side_diff = abs( (ground_next_x_dist + (ground_next_towards_dist * -unit_x) + (ground_next_side_dist * unit_y)) - ground_x ),
                                        neg_side_diff = abs( (ground_next_x_dist + (ground_next_towards_dist * -unit_x) + (ground_next_side_dist * -unit_y)) - ground_x ),
                                        ground_next_side_dist = ifelse(pos_side_diff < neg_side_diff,
                                                                   ground_next_side_dist, -ground_next_side_dist)) %>% 
                                 dplyr::select(-c(unit_x, unit_y, pos_side_diff, neg_side_diff)) %>%
                                 relocate(ground_next_side_dist, .before = ground_next_angle)
pot_tag_data <- pot_tag_data %>% mutate(ground_next_angle = atan2(ground_next_side_dist, ground_next_towards_dist))

